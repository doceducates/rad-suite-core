DATABASE_URL=postgresql://postgres:postgres@localhost:5435/rad_suite
DB_DIALECT=sqlite
SQLITE_PATH=./radsuite.db
PORT=3000
AUTH_SECRET=rad-suite-dev-secret-token-change-in-prod

# Universal AI Provider Configuration
# Options: 'local' | 'gemini' | 'openai' | 'openrouter' | 'groq' | 'offline-rules'
AI_PROVIDER=offline-rules
AI_LLM_PROVIDER=offline-rules
AI_STT_PROVIDER=local

# Local Offline Models (e.g. llama-server)
LOCAL_LLM_URL=http://127.0.0.1:3788/v1
LOCAL_LLM_MODEL=medgemma
LOCAL_MODELS_PATH=

# Cloud API Keys (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Unified 4-Source Storage Configuration
# 1. Local Workstation Storage (Zero-Latency Primary Cache)
LOCAL_CASES_PATH=E:\Cases

# 2. Hospital Live PACS (Ethernet / HMIS Wi-Fi)
PACS_ENABLED=true

# 3. Google Drive Headless Cloud Mirror (Service Account)
GDRIVE_ENABLED=false
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_EMAIL=
# Either set GDRIVE_PRIVATE_KEY here or save JSON as config/service-account.json
GDRIVE_PRIVATE_KEY=

# 4. S3-Compatible Cloud Storage (AWS S3 / MinIO / Cloudflare R2)
S3_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Clinic Node Gateway Microservice (VPS Hub)
CLINIC_GATEWAY_URL=https://radiology.sehatai.org/gateway
CLINIC_GATEWAY_API_KEY=your-32-char-clinic-gateway-key