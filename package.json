{
  "name": "rad-suite",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3780",
    "build": "node ./node_modules/next/dist/bin/next build --webpack",
    "start": "node ./node_modules/next/dist/bin/next start -p 4125",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:sqlite": "tsx src/db/seed-sqlite.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "generate:icons": "node ./scripts/generate-brand-assets.js",
    "tauri": "tauri",
    "hmis:start": "node -e \"const fs=require('fs'); if(fs.existsSync('plugins/hmis-gateway/package.json')){require('child_process').spawnSync('npm', ['--prefix', 'plugins/hmis-gateway', 'start'], {stdio:'inherit',shell:true});}else{console.log('HMIS Gateway plugin is not installed.');}\"",
    "hmis:dev": "node -e \"const fs=require('fs'); if(fs.existsSync('plugins/hmis-gateway/package.json')){require('child_process').spawnSync('npm', ['--prefix', 'plugins/hmis-gateway', 'dev'], {stdio:'inherit',shell:true});}else{console.log('HMIS Gateway plugin is not installed.');}\"",
    "plugins:dev-link": "node ./scripts/link-dev-plugins.js",
    "plugins:dev-clean": "node ./scripts/clean-dev-plugins.js",
    "mcp": "tsx src/mcp/cli.ts",
    "build:windows": "node ./scripts/build-dispatcher.js windows",
    "build:android": "node ./scripts/build-dispatcher.js android",
    "build:macos": "node ./scripts/build-dispatcher.js macos",
    "build:linux": "node ./scripts/build-dispatcher.js linux",
    "build:all": "node ./scripts/build-dispatcher.js all",
    "bump:patch": "node ./scripts/bump-version.js patch",
    "bump:minor": "node ./scripts/bump-version.js minor",
    "bump:major": "node ./scripts/bump-version.js major",
    "release": "node ./scripts/bump-version.js patch && npm run build:all"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.2",
    "@blocknote/mantine": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/extension-highlight": "^2.26.1",
    "@tiptap/extension-placeholder": "^2.26.1",
    "@tiptap/extension-subscript": "^2.27.3",
    "@tiptap/extension-superscript": "^2.27.3",
    "@tiptap/extension-text-align": "^2.26.1",
    "@tiptap/extension-underline": "^2.26.1",
    "@tiptap/pm": "^2.26.1",
    "@tiptap/react": "^2.26.1",
    "@tiptap/starter-kit": "^2.26.1",
    "@tiptap/suggestion": "^2.27.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/three": "^0.186.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dicom-parser": "^1.8.21",
    "docx": "^9.10.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "html5-qrcode": "^2.3.8",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.43.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.32",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@tauri-apps/cli": "^2.11.5",
    "@types/archiver": "^8.0.0",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "happy-dom": "^20.14.5",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
